{
  "name": "citybook",
  "private": true,
  "version": "0.1.0",
  "description": "Personal city guide: favourite places on a map, events, and adventures to plan and share.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "seed:sql": "node scripts/seed-to-sql.mjs",
    "db:migrate:local": "wrangler d1 migrations apply citybook --local",
    "db:seed:local": "npm run seed:sql && wrangler d1 execute citybook --local --file=seed/seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  }
}
